<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<StackPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.example.skinglow.ShowProductController"
            stylesheets="@styles/style.css"
            fx:id="showProductView"
            prefHeight="375"
            prefWidth="667"
            style="-fx-background-color: #FCFAF2;">
    <VBox alignment="CENTER"
          spacing="7"
          style="-fx-padding: 20;">
        <HBox alignment="CENTER">
            <ImageView fx:id="imageLogo"
                       fitWidth="55"
                       preserveRatio="true"/>
            <Label text="SkinGlow"
                   styleClass="logoLabelTiny"/>
        </HBox>
        <Label fx:id="nameLabel"
               wrapText="true"
               textAlignment="CENTER"
               maxWidth="320"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
        <ImageView fx:id="productImage"
                   fitWidth="240"
                   preserveRatio="true"/>
        <VBox fx:id="mainComponentColor"
              alignment="CENTER"
              maxWidth="180"
              styleClass="mainComponentVBox">
            <Label fx:id="mainComponentLabel"
                   styleClass="mainComponentLabel"
                   textAlignment="CENTER"/>
        </VBox>
        <VBox alignment="CENTER"
              spacing="15">
            <ScrollPane
                    maxWidth="290"
                    maxHeight="150"
                    fitToHeight="true"
                    hbarPolicy="NEVER"
                    styleClass="simpleScrollPane">
                <VBox maxWidth="290"
                      spacing="5">
                    <HBox alignment="CENTER"
                          spacing="5">
                        <Label fx:id="brandLabel"
                               style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-font-style: italic;"/>
                        <Label fx:id="priceLabel"
                               style="-fx-font-size: 16px;"/>
                    </HBox>
                    <VBox alignment="CENTER">
                        <Label text="Details"
                               textAlignment="CENTER"
                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                    </VBox>
                    <Label fx:id="presentationLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 13px;"/>
                    <Label fx:id="skinTypeLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 13px;"/>
                    <Label text="Product Type: "
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="productTypeLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                    <Label text="About the product: "
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="productInfoLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                    <Label text="How to Use it: "
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="howToUseLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                    <Label text="Benefits: "
                           style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
                    <Label fx:id="benefitsLabel"
                           maxWidth="290"
                           wrapText="true"
                           style="-fx-font-size: 12px;"/>
                </VBox>
            </ScrollPane>
            <HBox alignment="CENTER"
                  spacing="25">
                <Button text="Go Back"
                        fx:id="goBackButton"
                        wrapText="true"
                        textAlignment="CENTER"
                        maxWidth="120"
                        styleClass="smallStandardBlueButton"
                        onMouseClicked="#goToCatalogWindow"/>
                <Button text="Give Tips!"
                        wrapText="true"
                        textAlignment="CENTER"
                        maxWidth="120"
                        fx:id="giveTipsButton"
                        styleClass="smallStandardBlueButton"
                        onMouseClicked="#showTips"/>
                <Button text="To the website!"
                        wrapText="true"
                        textAlignment="CENTER"
                        maxWidth="120"
                        fx:id="toWebsiteButton"
                        styleClass="smallStandardBlueButton"
                        onMouseClicked="#toWebsite"/>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
